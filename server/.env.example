PORT=3000
NODE_ENV=development
AUTH_MODE=dev            # dev | firebase (set firebase for production)
ALLOW_DEV_AUTH=false     # only set true for temporary production testing with AUTH_MODE=dev
MONGO_URI=               # optional in Phase 1
RECONNECT_GRACE_MS=60000
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=   # path to service account json file (optional if using FIREBASE_SERVICE_ACCOUNT_JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=    # raw service account JSON (single line)
